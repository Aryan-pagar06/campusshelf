# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
CORS_ORIGIN=http://localhost:5173

# Database Connection (Placeholder - real Neon PostgreSQL URL will be configured in Database Phase)
DATABASE_URL="postgresql://user:password@localhost:5432/campusshelf?schema=public"

# Authentication (Will be configured in Auth Phase)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Email / OTP (Will be configured in Auth Phase)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Cloudinary (Will be configured in Image Upload Phase)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gemini API (Will be configured in AI Summaries Phase)
GEMINI_API_KEY=your_gemini_api_key
